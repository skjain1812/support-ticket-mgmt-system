# MongoDB connection string
# Local:  mongodb://localhost:27017/support_tickets
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/support_tickets
MONGODB_URI=mongodb://localhost:27017/support_tickets

# Port the Express API listens on
API_PORT=3000

# Allowed frontend origin for CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Optional: separate database for integration tests (tests/integration/)
# MONGODB_URI_TEST=mongodb://localhost:27017/support_tickets_test
